# ======================================================================================================================
# 6. SECURITY FILTERS & ACCESS RESTRICTIONS
# ======================================================================================================================

# ----------------------------------------------------------------------------------------------------------------------
# 6.1 REVERSE PROXY & CLOUDFLARE NORMALIZATION (REAL_IP & HTTPS)
# ----------------------------------------------------------------------------------------------------------------------
# Normalizes client IP and SSL state when operating behind Cloudflare, reverse proxies, or load balancers.
<IfModule mod_setenvif.c>
	# Detect upstream HTTPS termination (Cloudflare, AWS ALB, Nginx)
	SetEnvIfNoCase X-Forwarded-Proto https HTTPS=on
	SetEnvIfNoCase X-Forwarded-SSL on HTTPS=on
</IfModule>
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# 1. Default REAL_IP to direct TCP remote address
	RewriteRule .* - [E=REAL_IP:%{REMOTE_ADDR}]

	# 2. If request arrives via Cloudflare, dynamically override REAL_IP
	RewriteCond %{HTTP:CF-Connecting-IP} .
	RewriteRule .* - [E=REAL_IP:%{HTTP:CF-Connecting-IP}]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.2 STATIC ASSET PERFORMANCE SHORT-CIRCUIT (BYPASS DEEP REWRITE SCANS)
# ----------------------------------------------------------------------------------------------------------------------
# If an actual static file exists on disk, stop rewrite evaluation immediately with [L].
# This ensures static requests (CSS, JS, fonts, images) bypass all exploit scanner rules below, saving CPU and TTFB.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_FILENAME} -f
	RewriteCond %{REQUEST_URI} \.(avifs?|bmp|css|cur|eot|gif|heic|heif|ico|jpe?g|js|json|mjs|mp4|ogg|otf|png|svgz?|ttf|webp|woff2?)$ [NC]
	RewriteRule ^ - [L]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.3 ADVANCED EARLY-DROP PROTECTION: BLOCK SCANNERS & EXPLOIT PROBES
# ----------------------------------------------------------------------------------------------------------------------
# Drops known automated vulnerability scans, shell probes, and exploit payloads immediately at the Apache web server layer
# with 403 Forbidden [F,L] before PHP or the WordPress database initializes, saving CPU and database connections.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# 0. Restrict HTTP Methods: Block Unusual / Potentially Dangerous Request Methods (Permits standard WP REST methods)
	RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD|PUT|DELETE|OPTIONS|PATCH)$ [NC]
	RewriteRule .* - [F,L]

	# 1. Block Probes for Non-WordPress Executable & Legacy Framework Extensions
	RewriteRule \.(jsp|asp|aspx|action|do|cgi|cfm|pl|dll|exe|nsf)$ - [F,L,NC]

	# 2. Block Environment, Config, and Cloud Metadata Probes (Catches .env*, .git*, .aws*, .kube*, etc.)
	RewriteRule (^|/)(\.env.*|\.git.*|\.svn.*|\.dockercfg.*|\.aws.*|\.kube.*|\.npmrc.*|\.DS_Store|\.editorconfig|\.ssh.*|\.bash_history|web\.config.*)$ - [F,L,NC]

	# 3. Block Developer Manifests, Lockfiles & Cloud Credentials (composer.json, .pem, .key, GCP/AWS/Firebase keys)
	RewriteRule (^|/)(package\.json|package-lock\.json|composer\.json|composer\.lock|yarn\.lock|pnpm-lock\.yaml|bun\.lockb|tsconfig\.json|webpack\.config\.(js|ts)|vite\.config\.(js|ts))$ - [F,L,NC]
	RewriteRule (firebase-adminsdk|service-account|serviceAccountKey|credentials|secrets|gcp-credentials|gcp-key|gcp-sa|google-credentials|google-key|firebase-key|keyfile|sa|application_default_credentials)\.(json|ya?ml)$ - [F,L,NC]
	RewriteRule (server|localhost|privatekey|private-key|host|key)\.(key|pem)$ - [F,L,NC]
	RewriteRule (terraform\.tfstate|rclone\.conf|Dockerfile|docker-compose\.ya?ml)$ - [F,L,NC]

	# 4. Block Database Dumps, Backups, and Migration/Installer Scripts
	# Targets database dumps and full-site backups without blocking legitimate WooCommerce/EDD digital product downloads.
	RewriteRule \.(sql|sqlite|db|dump|bak|backup|old|orig|swp)$ - [F,L,NC]
	RewriteRule (^|[-_./])(backup|dump|database|db|export|snapshot|all-in-one-wp-migration|site-backup)[-_./0-9a-zA-Z]*\.(tar|gz|tgz|zip|rar)$ - [F,L,NC]
	RewriteRule (installer.*\.php|dup-installer|import-backup.*\.php) - [F,L,NC]
	# Optional: Block all downloadable archives (Do NOT enable if legitimately selling digital products via WooCommerce/EDD)
	# RewriteRule \.(tar|gz|tgz|zip|rar)$ - [F,L,NC]

	# 5. Block Known Web Shells, Diagnostic Files & Framework RCE Probes (c99, terminal-xhr, inngest, phpinfo)
	RewriteRule (eval-stdin\.php|alfa.*\.php|wso.*\.php|c99.*\.php|r57.*\.php|b374k.*\.php|shell\.php|cmd\.php|adminer.*\.php|phpmyadmin.*\.php) - [F,L,NC]
	RewriteRule (terminal-xhr\.php|api/fs/exec|read-document|api/templates/preview|api/designer/v1/file-content|proc/self/environ|api/inngest) - [F,L,NC]
	RewriteRule (^(pi|i|p|php|pinfo|php-info|phpinfo|info|phpversion|server-status|server-info)\.php|\/phpinfo\.php)$ - [F,L,NC]

	# 5b. Block GraphQL Introspection Probes (OPTIONAL - Do NOT enable if using WPGraphQL)
	# RewriteRule ^graphql/? - [F,L,NC]

	# 6. Block Enterprise Appliances, Framework Profilers, VPNs, and Remote Desktop (telescope, profiler, actuator, ecp, RDWeb)
	# Scoped specifically to exploit endpoints to avoid blocking legitimate page slugs (e.g. /remote/jobs/ or /vpn/reviews/)
	RewriteRule ^(dana-na|remote/(login|fgt_lang|hostcheck|dashboard)|logon/LogonPoint|RDWeb|vpn/index\.html|wsman|autodiscover|ews|ecp|solr/|console/login|crowd/|CTCWebService|actuator|swagger-ui|api-docs|v2/api-docs|telescope/|debug/default|_profiler|_ignition|_environment|@vite/|trace\.axd) - [F,L,NC]

	# 7. Block Malicious Query String Injections & Directory Traversal Exploits (eval, base64, <script, ../)
	RewriteCond %{QUERY_STRING} (base64_encode|base64_decode|eval\(|<script|GLOBALS\[|_REQUEST\[|\.\./|\.\.%2f|fgt_lang) [NC]
	RewriteRule .* - [F,L]

	# 8. Block Direct PHP Execution in Uploads, Languages & Upgrade Dirs (Malware Staging Defense)
	RewriteRule ^wp-content/(uploads|blogs\.dir|languages|upgrade)/.*(?i)\.(php[0-9]?|pht|phtml?|phps|phar|pl|py|cgi)$ - [F,L]

	# 9. Block Direct PHP Execution Inside Themes Directory (Template files should only be executed by WordPress core)
	RewriteRule ^wp-content/themes/.*(?i)\.(php[0-9]?|pht|phtml?|phps|phar)$ - [F,L]

	# 9b. Block Direct PHP Execution Inside Plugins Directory (OPTIONAL)
	# (!) CAUTION: Many plugins (e.g. WooCommerce payment webhooks, PayPal IPN, captcha generators) require direct PHP
	# execution. Only uncomment if you have thoroughly tested your site's checkout flows and AJAX integrations.
	# RewriteRule ^wp-content/plugins/.*(?i)\.(php[0-9]?|pht|phtml?|phps|phar)$ - [F,L]

	# 10. Block WordPress REST API User Enumeration Scans (/wp-json/wp/v2/users)
	# Excludes /wp-json/wp/v2/users/me so authenticated user profile lookups succeed
	RewriteCond %{REQUEST_URI} !^/wp-json/wp/v2/users/me [NC]
	RewriteCond %{REQUEST_URI} ^/wp-json/wp/v2/users(/|$) [NC,OR]
	RewriteCond %{QUERY_STRING} rest_route=(/|%2f)wp(/|%2f)v2(/|%2f)users(/|%2f|&|$) [NC]
	RewriteCond %{QUERY_STRING} !context=edit [NC]
	RewriteRule .* - [F,L]

	# 11. Block Known Vulnerability Scanners & Exploit Tool User-Agents (wpscan, sqlmap, nikto, masscan, etc.)
	RewriteCond %{HTTP_USER_AGENT} (acunetix|dirbuster|gobuster|havij|masscan|nessus|nikto|nmap|openvas|shodan|sqlmap|wpscan|zgrab) [NC]
	RewriteRule .* - [F,L]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.4 BLOCK ACCESS TO HIDDEN FILES & DIRECTORIES
# ----------------------------------------------------------------------------------------------------------------------
# Blocks access to dotfiles and hidden folders (e.g. .git, .env) while explicitly preserving access to
# /.well-known/acme-challenge/ so automated Let's Encrypt / Certbot SSL certificate renewals function properly.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_URI} !^/\.well-known/
	RewriteRule "(^|/)\." - [F,L]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.5 FILE ACCESS PROTECTIONS (APACHE 2.4 & 2.2 DUAL-COMPATIBLE)
# ----------------------------------------------------------------------------------------------------------------------
# Uses dual <IfModule mod_authz_core.c> (Apache 2.4 'Require all denied') and fallback (!mod_authz_core.c 'Deny from all')
# to prevent HTTP 500 errors across both legacy and modern hosting environments.

# Protect this .htaccess file and other .ht* files (.htpasswd, .htgroup)
<FilesMatch "^\.([Hh][Tt])">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
		Satisfy All
	</IfModule>
</FilesMatch>

# Protect Sensitive File Extensions (Source code, logs, configs, database backups, editor swaps)
<FilesMatch "(^#.*#|\.(bak|conf|config|dist|fla|in[ci]|ini|log|old|orig|original|psd|sh|sql|sw[op])|~)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
		Satisfy All
	</IfModule>
</FilesMatch>

# Disable Direct Access to PHP Configuration Files (.user.ini, php.ini)
<FilesMatch "^(\.user\.ini|php\.ini)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Disable Direct Access to WordPress Configuration and Sample Files
<FilesMatch "^(wp-config\.php|wp-config-sample\.php)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Disable Direct Access to WordPress Debug Log
<Files "debug.log">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</Files>

# Disable Direct Access to SFTP Deployment Configuration
<Files "sftp-config.json">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</Files>

# Prevent WordPress Version Exposure via Readme / License Files
<FilesMatch "(?i)^(readme|license|licence)\.(html|txt|md)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Disable XML-RPC (Prevents Brute-Force & Amplification DDoS Attacks)
# See:
# * https://blog.sucuri.net/2015/10/brute-force-amplification-attacks-against-wordpress-xmlrpc.html
# * https://www.digitalocean.com/community/tutorials/how-to-protect-wordpress-from-xml-rpc-attacks-on-ubuntu-14-04#method-3-manually-blocking-all-xml-rpc-traffic
<Files "xmlrpc.php">
	<IfModule mod_authz_core.c>
		# To allow Jetpack or the WordPress Mobile App, uncomment the lines below:
		# Require ip 192.0.64.0/18
		# Require ip 122.248.245.244/32
		# Require ip 54.217.201.243/32
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
		# Allow from 192.0.64.0/18
	</IfModule>
</Files>


# ----------------------------------------------------------------------------------------------------------------------
# 6.6 CORE WORDPRESS DIRECTORY HARDENING
# ----------------------------------------------------------------------------------------------------------------------

# Block Direct Access to WordPress Installer (wp-admin/install.php)
# Once WordPress is installed, install.php is never legitimately needed.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^wp-admin/install\.php$ - [F,L,NC]
</IfModule>

# Restrict Direct Access to WP-Includes PHP Files
# See: https://wordpress.org/documentation/article/hardening-wordpress/#securing-wp-includes
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteRule ^wp-admin/includes/ - [F,L]
	RewriteRule !^wp-includes/ - [S=3]
	RewriteRule ^wp-includes/[^/]+\.php$ - [F,L]
	RewriteRule ^wp-includes/js/tinymce/langs/.+\.php - [F,L]
	RewriteRule ^wp-includes/theme-compat/ - [F,L]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.7 IMAGE HOTLINKING DEFENSE (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# Prevents external websites from stealing server bandwidth by directly embedding your media files in their pages.
# Permits empty referrers (direct navigation, privacy extensions) and requests originating from your own domain.
#
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteCond %{HTTP_REFERER} !^$
#	RewriteCond %{HTTP_REFERER} !^https?://(www\.)?example\.com [NC]
#	RewriteRule \.(avif|gif|heic|heif|jpe?g|png|webp)$ - [NC,F,L]
#</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.8 BOT, ENUMERATION & SPAM QUERY FILTERING (RUNS ON DYNAMIC REQUESTS ONLY)
# ----------------------------------------------------------------------------------------------------------------------

# Stop WordPress Username Enumeration Scans (?author=1)
# Scoped to front-end pages; excludes /wp-admin and /wp-json to preserve admin and REST API author queries
# See: https://www.wpbeginner.com/wp-tutorials/how-to-discourage-brute-force-by-blocking-author-scans-in-wordpress/
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteCond %{REQUEST_URI} !^/wp-admin [NC]
	RewriteCond %{REQUEST_URI} !^/wp-json [NC]
	RewriteCond %{QUERY_STRING} (author=\d+) [NC]
	RewriteRule .* - [F,L]
</IfModule>

# Block Advanced SQL Injection (SQLi) & Remote File Inclusion (RFI) Query Payloads
# Drops common database extraction patterns (UNION SELECT, BENCHMARK, SLEEP, null bytes, /etc/passwd traversal).
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{QUERY_STRING} (concat|union.*select|information_schema|benchmark|sleep\([0-9]+\)|load_file|cast\(|md5\() [NC,OR]
	RewriteCond %{QUERY_STRING} (%00|%2500|\0) [NC,OR]
	RewriteCond %{QUERY_STRING} (=(\/|\\)\.\.(\/|\\)|(boot|win)\.ini|\/etc\/(passwd|shadow|hosts)) [NC]
	RewriteRule .* - [F,L]
</IfModule>

# Block Automated No-Referrer Comment Spam Bots (wp-comments-post.php)
# Legitimate user comments always arrive with a valid HTTP referrer matching the site's domain.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_METHOD} POST
	RewriteCond %{REQUEST_URI} ^/wp-comments-post\.php$ [NC]
	RewriteCond %{HTTP_REFERER} !^https?://(www\.)?%{HTTP_HOST} [NC,OR]
	RewriteCond %{HTTP_USER_AGENT} ^$
	RewriteRule .* - [F,L]
</IfModule>

# Block Common Malicious Bot Queries & Scanner Payloads (TimThumb, FCKeditor, RevSlider exploits)
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{QUERY_STRING} http\:\/\/www\.google\.com\/humans\.txt\? [NC,OR]
	RewriteCond %{QUERY_STRING} (img|thumb|thumb_editor|thumbopen)\.php [NC,OR]
	RewriteCond %{QUERY_STRING} fckeditor [NC,OR]
	RewriteCond %{QUERY_STRING} revslider [NC]
	RewriteRule .* - [F,L]
</IfModule>

# Abuse HTTP Referrer Blocking (Blocks Additional Scraper & Referrer Spam Networks)
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTP_REFERER} buttons-for-your-website\.com [NC,OR]
	RewriteCond %{HTTP_REFERER} free-social-buttons\.com [NC]
	RewriteRule .* - [F,L]
</IfModule>

# Block Known Drupal/CMS Spam Bot Registration Probes
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{QUERY_STRING} q=(user/register|node/add) [NC]
	RewriteRule .* - [F,L]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.9 8G FIREWALL (PERISHABLE PRESS)
# ----------------------------------------------------------------------------------------------------------------------
# 8G FIREWALL v1.5 20250927
# https://perishablepress.com/8g-firewall/

# Addon available: Block AI Bots
# https://perishablepress.com/ultimate-ai-block-list/

# 8G:[CORE]
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
</IfModule>

# 8G:[QUERY STRING]
<IfModule mod_rewrite.c>

	RewriteCond %{QUERY_STRING} ^(%2d|-)[^=]+$ [NC,OR]
	RewriteCond %{QUERY_STRING} ([a-z0-9]{4000,}) [NC,OR]
	RewriteCond %{QUERY_STRING} (/|%2f)(:|%3a)(/|%2f) [NC,OR]
	RewriteCond %{QUERY_STRING} (etc/(hosts|motd|shadow)) [NC,OR]
	RewriteCond %{QUERY_STRING} (order(\s|%20)by(\s|%20)1--) [NC,OR]
	RewriteCond %{QUERY_STRING} (/|%2f)(\*|%2a)(\*|%2a)(/|%2f) [NC,OR]
	RewriteCond %{QUERY_STRING} (`|<|>|\^|\|\\|0x00|%00|%0d%0a) [NC,OR]
	RewriteCond %{QUERY_STRING} (f?ckfinder|f?ckeditor|fullclick) [NC,OR]
	RewriteCond %{QUERY_STRING} ((.*)header:|(.*)set-cookie:(.*)=) [NC,OR]
	RewriteCond %{QUERY_STRING} (localhost|127(\.|%2e)0(\.|%2e)0(\.|%2e)1) [NC,OR]
	RewriteCond %{QUERY_STRING} (cmd|command)(=|%3d)(chdir|mkdir)(.*)(x20) [NC,OR]
	RewriteCond %{QUERY_STRING} (globals|mosconfig([a-z_]{1,22})|(?<!SAML)request)(=|\[) [NC,OR]
	RewriteCond %{QUERY_STRING} (/|%2f)((wp-)?config)((\.|%2e)inc)?((\.|%2e)php) [NC,OR]
	RewriteCond %{QUERY_STRING} (thumbs?(_editor|open)?|tim(thumbs?)?)((\.|%2e)php) [NC,OR]
	RewriteCond %{QUERY_STRING} (absolute_|base|root_)(dir|path)(=|%3d)(ftp|https?) [NC,OR]
	RewriteCond %{QUERY_STRING} (s)?(ftp|inurl|php)(s)?(:(/|%2f|%u2215)(/|%2f|%u2215)) [NC,OR]
	RewriteCond %{QUERY_STRING} (\.|20)(get|the)(_|%5f)(permalink|posts_page_url)(\(|%28) [NC,OR]
	RewriteCond %{QUERY_STRING} ((boot|win)((\.|%2e)ini)|etc(/|%2f)passwd|self(/|%2f)environ) [NC,OR]
	RewriteCond %{QUERY_STRING} (((/|%2f){3,3})|((\.|%2e){3,3})|((\.|%2e){2,2})(/|%2f|%u2215)) [NC,OR]
	RewriteCond %{QUERY_STRING} (benchmark|exec|fopen|function|html)(.*)(\(|%28)(.*)(\)|%29) [NC,OR]
	RewriteCond %{QUERY_STRING} (php)([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}) [NC,OR]
	RewriteCond %{QUERY_STRING} (e|%65|%45)(v|%76|%56)(a|%61|%31)(l|%6c|%4c)(.*)(\(|%28)(.*)(\)|%29) [NC,OR]
	RewriteCond %{QUERY_STRING} (/|%2f)(=|%3d|$&|_mm|cgi(\.|-)|inurl(:|%3a)(/|%2f)|(mod|path)(=|%3d)(\.|%2e)) [NC,OR]
	RewriteCond %{QUERY_STRING} (<|%3c)(.*)(e|%65|%45)(m|%6d|%4d)(b|%62|%42)(e|%65|%45)(d|%64|%44)(.*)(>|%3e) [NC,OR]
	RewriteCond %{QUERY_STRING} (<|%3c)(.*)(i|%69|%49)(f|%66|%46)(r|%72|%52)(a|%61|%41)(m|%6d|%4d)(e|%65|%45)(.*)(>|%3e) [NC,OR]
	RewriteCond %{QUERY_STRING} (<|%3c)(.*)(o|%4f|%6f)(b|%62|%42)(j|%4a|%6a)(e|%65|%45)(c|%63|%43)(t|%74|%54)(.*)(>|%3e) [NC,OR]
	RewriteCond %{QUERY_STRING} (<|%3c)(.*)(s|%73|%53)(c|%63|%43)(r|%72|%52)(i|%69|%49)(p|%70|%50)(t|%74|%54)(.*)(>|%3e) [NC,OR]
	RewriteCond %{QUERY_STRING} (\+|%2b|%20)(d|%64|%44)(e|%65|%45)(l|%6c|%4c)(e|%65|%45)(t|%74|%54)(e|%65|%45)(\+|%2b|%20) [NC,OR]
	RewriteCond %{QUERY_STRING} (\+|%2b|%20)(i|%69|%49)(n|%6e|%4e)(s|%73|%53)(e|%65|%45)(r|%72|%52)(t|%74|%54)(\+|%2b|%20) [NC,OR]
	RewriteCond %{QUERY_STRING} (\+|%2b|%20)(s|%73|%53)(e|%65|%45)(l|%6c|%4c)(e|%65|%45)(c|%63|%43)(t|%74|%54)(\+|%2b|%20) [NC,OR]
	RewriteCond %{QUERY_STRING} (\+|%2b|%20)(u|%75|%55)(p|%70|%50)(d|%64|%44)(a|%61|%41)(t|%74|%54)(e|%65|%45)(\+|%2b|%20) [NC,OR]
	RewriteCond %{QUERY_STRING} (\\x00|(\"|%22|\'|%27)?0(\"|%22|\'|%27)?(=|%3d)(\"|%22|\'|%27)?0|cast(\(|%28)0x|or%201(=|%3d)1) [NC,OR]
	RewriteCond %{QUERY_STRING} (g|%67|%47)(l|%6c|%4c)(o|%6f|%4f)(b|%62|%42)(a|%61|%41)(l|%6c|%4c)(s|%73|%53)(=|\[|%[0-9A-Z]{0,2}) [NC,OR]
	RewriteCond %{QUERY_STRING} (_|%5f)(r|%72|%52)(e|%65|%45)(q|%71|%51)(u|%75|%55)(e|%65|%45)(s|%73|%53)(t|%74|%54)(=|\[|%[0-9A-Z]{2,}) [NC,OR]
	RewriteCond %{QUERY_STRING} (j|%6a|%4a)(a|%61|%41)(v|%76|%56)(a|%61|%31)(s|%73|%53)(c|%63|%43)(r|%72|%52)(i|%69|%49)(p|%70|%50)(t|%74|%54)(:|%3a)(.*)(;|%3b|\)|%29) [NC,OR]
	RewriteCond %{QUERY_STRING} (b|%62|%42)(a|%61|%41)(s|%73|%53)(e|%65|%45)(6|%36)(4|%34)(_|%5f)(e|%65|%45|d|%64|%44)(e|%65|%45|n|%6e|%4e)(c|%63|%43)(o|%6f|%4f)(d|%64|%44)(e|%65|%45)(.*)(\()(.*)(\)) [NC,OR]
	RewriteCond %{QUERY_STRING} (@copy|\$_(files|get|post)|allow_url_(fopen|include)|auto_prepend_file|blexbot|browsersploit|call_user_func_array|(php|web)shell|curl(_exec|test)|disable_functions?|document_root) [NC,OR]
	RewriteCond %{QUERY_STRING} (elastix|encodeuricom|exploit|fclose|fgets|file_put_contents|fputs|fsbuff|fsockopen|gethostbyname|grablogin|hmei7|hubs_post-cta|input_file|invokefunction|(\b)load_file|open_basedir|outfile|p3dlite) [NC,OR]
	RewriteCond %{QUERY_STRING} (pass(=|%3d)shell|passthru|phpinfo|phpshells|popen|proc_open|quickbrute|remoteview|root_path|safe_mode|shell_exec|site((.){0,2})copier|sp_executesql|sux0r|trojan|udtudt|user_func_array|wget|wp_insert_user|xertive) [NC,OR]
	# Note: %22| is removed below for WordPress Media Library exact-match attachment search compatibility
	RewriteCond %{QUERY_STRING} (;|<|>|\'|\"|\)|%0a|%0d|%27|%3c|%3e|%00)(.*)(/\*|alter|base64|benchmark|cast|concat|convert|create|encode|declare|delay|delete|drop|hex|insert|load|md5|null|replace|request|script|select|set|sleep|truncate|unhex|update) [NC,OR]
	RewriteCond %{QUERY_STRING} ((\+|%2b)(concat|delete|get|select|union)(\+|%2b)) [NC,OR]
	RewriteCond %{QUERY_STRING} (union)(.*)(select)(.*)(\(|%28) [NC,OR]
	RewriteCond %{QUERY_STRING} (concat|eval)(.*)(\(|%28) [NC]

	RewriteRule .* - [F]

	# RewriteRule .* /nG_log.php?log [END,NE,E=nG_QUERY_STRING:%1___%2___%3]

</IfModule>

# 8G:[REQUEST URI]
<IfModule mod_rewrite.c>

	RewriteCond %{REQUEST_URI} (,,,) [NC,OR]
	RewriteCond %{REQUEST_URI} (-------) [NC,OR]
	RewriteCond %{REQUEST_URI} (\^|`|<|>|\\|\|) [NC,OR]
	RewriteCond %{REQUEST_URI} ([a-z0-9]{2000,}) [NC,OR]
	RewriteCond %{REQUEST_URI} (=?\\(\'|%27)/?)(\.) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(\*|\"|\'|\.|,|&|&amp;?)/?$ [NC,OR]
	RewriteCond %{REQUEST_URI} (\.)(php)(\()?([0-9]+)(\))?(/)?$ [NC,OR]
	RewriteCond %{REQUEST_URI} /((.*)header:|(.*)set-cookie:(.*)=) [NC,OR]
	RewriteCond %{REQUEST_URI} (\.(s?ftp-?)config|(s?ftp-?)config\.) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(f?ckfinder|fck/|fckeditor|fullclick) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)((force-)?download|framework/main)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (\{0\}|\"?0\"?=\"?0|\(/\(|\.\.\.|\+\+\+|\\\") [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(vbull(etin)?|boards|vbforum|vbweb|webvb)(/)? [NC,OR]
	RewriteCond %{REQUEST_URI} (\.|20)(get|the)(_)(permalink|posts_page_url)(\() [NC,OR]
	RewriteCond %{REQUEST_URI} (///|\?\?|/&&|/\*(.*)\*/|/:/|\\\\|0x00|%00|%0d%0a) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(cgi_?)?alfa(_?cgiapi|_?data|_?v[0-9]+)?(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (thumbs?(_editor|open)?|tim(thumbs?)?)((\.|%2e)php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)((boot)?_?admin(er|istrator|s)(_events)?)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/%7e)(root|ftp|bin|nobody|named|guest|logs|sshd)(/) [NC,OR]
	RewriteCond %{REQUEST_URI} (archive|backup|db|master|sql|wp|www|wwwroot)\.(gz|zip) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(\.?mad|alpha|c99|php|web)?sh(3|e)ll([0-9]+|\w)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(admin-?|file-?)(upload)(bg|_?file|ify|svu|ye)?(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(etc|var)(/)(hidden|secret|shadow|ninja|passwd|tmp)(/)?$ [NC,OR]
	RewriteCond %{REQUEST_URI} (s)?(ftp|http|inurl|php)(s)?(:(/|%2f|%u2215)(/|%2f|%u2215)) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(=|\$&?|&?(pws|rk)=0|_mm|_vti_|cgi(\.|-)|(=|/|;|,)nt\.) [NC,OR]
	RewriteCond %{REQUEST_URI} (\.)(ds_store|htaccess|htpasswd|init?|mysql-select-db)(/)?$ [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(bin)(/)(cc|chmod|chsh|cpp|echo|id|kill|mail|nasm|perl|ping|ps|python|tclsh)(/)?$ [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(::[0-9999]|%3a%3a[0-9999]|127\.0\.0\.1|ccx|localhost|makefile|pingserver|wwwroot)(/)? [NC,OR]
	RewriteCond %{REQUEST_URI} ^(/)(123|backup|bak|beta|bkp|default|demo|dev(new|old)?|new-?site|null|old|old_files|old1)(/)?$ [NC,OR]
	RewriteCond %{REQUEST_URI} (/)?j((\s)+)?a((\s)+)?v((\s)+)?a((\s)+)?s((\s)+)?c((\s)+)?r((\s)+)?i((\s)+)?p((\s)+)?t((\s)+)?(%3a|:) [NC,OR]
	RewriteCond %{REQUEST_URI} ^(/)(old-?site(back)?|old(web)?site(here)?|sites?|staging|undefined|wordpress([0-9]+)|wordpress-old)(/)?$ [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(filemanager|htdocs|httpdocs|https?|mailman|mailto|msoffice|undefined|var|vhosts|webmaster|www)(/) [NC,OR]
	RewriteCond %{REQUEST_URI} (\(null\)|\{\$itemURL\}|cast\(0x|echo(.*)kae|etc/passwd|eval\(|null(.*)null|open_basedir|self/environ|\+union\+all\+select) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(db-?|j-?|my(sql)?-?|setup-?|web-?|wp-?)?(admin-?)?(setup-?)?(conf\b|conf(ig)?)(uration)?(\.?bak|\.inc)?(\.inc|\.old|\.php|\.txt) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)((.*)crlf-?injection|(.*)xss-?protection|__(inc|jsc)|author-panel|cgi-bin|database|downloader|(db|mysql)-?admin)(/) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(haders|head|hello|helpear|incahe|includes?|indo(sec)?|infos?|ioptimizes?|jmail|js|king|kiss|kodox|kro|legion|libsoft)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(awstats|document_root|dologin\.action|error.log|extension/ext|htaccess\.|lib/php|listinfo|phpunit/php|remoteview|server/php|www\.root\.) [NC,OR]
	RewriteCond %{REQUEST_URI} (base64_(en|de)code|benchmark|curl_exec|echr|eval|function|fwrite|(f|p)open|html|leak|passthru|p?fsockopen|phpinfo)(.*)(\(|%28)(.*)(\)|%29) [NC,OR]
	RewriteCond %{REQUEST_URI} (posix_(kill|mkfifo|setpgid|setsid|setuid)|(child|proc)_(close|get_status|nice|open|terminate)|(shell_)?exec|system)(.*)(\(|%28)(.*)(\)|%29) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)((c99|php|web)?shell|crossdomain|fileditor|locus7|nstview|php(get|remoteview|writer)|r57|remview|sshphp|storm7|webadmin)(.*)(\.|%2e|\(|%28) [NC,OR]
	RewriteCond %{REQUEST_URI} /((wp-)((201\d|202\d|[0-9]{2})|ad|admin(fx|rss|setup)|booking|confirm|crons|data|file|mail|one|plugins?|readindex|reset|setups?|story))(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(^$|-|\!|\w|\.(.*)|100|123|([^iI])?ndex|index\.php/index|3xp|777|7yn|90sec|99|active|aill|ajs\.delivery|al277|alexuse?|ali|allwrite)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(analyser|apache|apikey|apismtp|authenticat(e|ing)|autoload_classmap|backup(_index)?|bakup|bkht|black|bogel|bookmark|bypass|cachee?)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(clean|cm(d|s)|con|connector\.minimal|contexmini|contral|curl(test)?|data(base)?|db|db-cache|db-safe-mode|defau11|defau1t|dompdf|dst)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(elements|emails?|error.log|ecscache|edit-form|eval-stdin|evil|fbrrchive|filemga|filenetworks?|f0x|gank(\.php)?|gass|gel|guide)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(logo_img|lufix|mage|marg|mass|mide|moon|mssqli|mybak|myshe|mysql|mytag_js?|nasgor|newfile|news|nf_?tracking|nginx|ngoi|ohayo|old-?index)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(olux|owl|pekok|petx|php-?info|phpping|popup-pomo|priv|r3x|radio|rahma|randominit|readindex|readmy|reads|repair-?bak|robot(s\.txt)?|root)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(router|savepng|semayan|shell|shootme|sky|socket(c|i|iasrgasf)ontrol|sql(bak|_?dump)?|support|sym403|sys|system_log|test|tmp-?(uploads)?)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(traffic-advice|u2p|udd|ukauka|up__uzegp|up14|upa?|upxx?|vega|vip|vu(ln)?(\w)?|webroot|weki|wikindex|wordpress|wp_logns?|wp_wrong_datlib)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (/)(wp-?install|installation|wp(3|4|5|6)|wpfootes|wpzip|ws0|wsdl|wso(\w)?|www|(uploads|wp-admin)?xleet(-shell)?|xmlsrpc|xup|xxu|xxx|zibi|zipy)(\.php) [NC,OR]
	RewriteCond %{REQUEST_URI} (bkv74|cachedsimilar|core-stab|crgrvnkb|ctivrc|deadcode|deathshop|dkiz|e7xue|eqxafaj90zir|exploits|ffmkpcal|filellli7|(fox|sid)wso|gel4y|goog1es|gvqqpinc) [NC,OR]
	RewriteCond %{REQUEST_URI} (@md5|00.temp00|0byte|0d4y|0day|0xor|wso1337|1h6j5|3xp|40dd1d|4price|70bex?|a57bze893|abbrevsprl|abruzi|adminer|aqbmkwwx|archivarix|backdoor|beez5|bgvzc29) [NC,OR]
	RewriteCond %{REQUEST_URI} (handler_to_code|hax(0|o)r|hmei7|hnap1|home_url=|ibqyiove|icxbsx|indoxploi|jahat|jijle3|kcrew|keywordspy|laobiao|lock360|longdog|marijuan|mod_(aratic|ariimag)) [NC,OR]
	RewriteCond %{REQUEST_URI} (mobiquo|muiebl|nessus|osbxamip|phpunit|priv8|qcmpecgy|r3vn330|racrew|raiz0|reportserver|r00t|respectmus|rom2823|roseleif|sh3ll|site((.){0,2})copier|sqlpatch|sux0r) [NC,OR]
	RewriteCond %{REQUEST_URI} (sym403|telerik|uddatasql|utchiha|visualfrontend|w0rm|wangdafa|wpyii2|wsoyanzo|x5cv|xattack|xbaner|xertive|xiaolei|xltavrat|xorz|xsamxad|xsvip|xxxs?s?|zabbix|zebda) [NC,OR]
	RewriteCond %{REQUEST_URI} (\.)(7z|ab4|ace|afm|alfa|as(h|m)x?|aspx?|aws|axd|bash|ba?k?|bat|bz2|cfg|cfml?|cgi|cms|conf\b|config|ctl|dat|db|dist|dll|eml|eng(ine)?|env|et2|exe|fec|fla|git(ignore)?)$ [NC,OR]
	RewriteCond %{REQUEST_URI} (\.)(hg|idea|inc|index|ini|inv|jar|jspa?|lib|local|log|lqd|make|mbf|mdb|mmw|mny|mod(ule)?|msi|old|one|orig|out|passwd|pdb|php\.(php|suspect(ed)?)|php([^\/])|phtml?|pl|profiles?)$ [NC,OR]
	RewriteCond %{REQUEST_URI} (\.)(psd|pst|ptdb|production|pwd|py|qbb|qdf|rar|rdf|remote|save|sdb|sql|sh|soa|svn|swf|swl|swo|swp|stx|tar|tax|tgz?|theme|tls|tmb|tmd|wok|wow|xsd|xtmpl|xz|ya?ml|za|zlib)$ [NC]

