# ======================================================================================================================
# 7. URL CANONICALIZATION, HTTPS & REDIRECTS
# ======================================================================================================================

# ----------------------------------------------------------------------------------------------------------------------
# RECOGNIZE SSL TERMINATED AT LOAD BALANCER / REVERSE PROXY (CLOUDFLARE)
# ----------------------------------------------------------------------------------------------------------------------
# Ensures Apache recognizes requests as HTTPS when SSL termination occurs upstream at Cloudflare or a load balancer.
<IfModule mod_setenvif.c>
	SetEnvIf X-Forwarded-Proto https HTTPS=on
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# TEMPORARILY REDIRECT HTTPS TO HTTP (TROUBLESHOOTING ONLY)
# ----------------------------------------------------------------------------------------------------------------------
# Problem with your SSL certificate? Uncomment to temporarily redirect to HTTP while keeping the full request URI.
#
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteCond %{HTTPS} on
#	RewriteRule ^ http://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# FORCE SSL / HTTPS REDIRECTION (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# Redirects all incoming HTTP traffic to HTTPS (Port 443).
#
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteCond %{HTTPS} !=on
#	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# URL CANONICALIZATION: REDIRECT WWW TO NAKED DOMAIN (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# Redirects https://www.example.com/page -> https://example.com/page
#
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteBase /
#	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
#	RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# URL CANONICALIZATION: REDIRECT NAKED DOMAIN TO WWW (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# Redirects https://example.com/page -> https://www.example.com/page
#
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteBase /
#	RewriteCond %{HTTP_HOST} !^www\. [NC]
#	RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# REDIRECT DIRECT IP ACCESS TO DOMAIN NAME (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# If a visitor enters your server's raw IP address in the browser, redirects them to your primary domain.
#
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteBase /
#	RewriteCond %{HTTP_HOST} ^186\.753\.090\.123$
#	RewriteRule ^ https://example.com%{REQUEST_URI} [R=301,L]
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# REDIRECT INCORRECT ROBOTS.TXT REQUESTS TO ROOT ROBOTS.TXT
# ----------------------------------------------------------------------------------------------------------------------
# Source: https://perishablepress.com/htaccess-cleanup/
<IfModule mod_alias.c>
	RedirectMatch 301 (?<!^)/robots\.txt$ /robots.txt
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# SERVE STAGING ROBOTS.TXT ON STAGING SUBDOMAINS (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# Serves a "Do Not Index" robots-staging.txt file only when accessed via a staging subdomain.
# Source: https://serverfault.com/a/884023/396075
#
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteBase /
#	RewriteCond %{HTTP_HOST} ^(.*)?stagingserver(\.com) [NC]
#	RewriteRule ^robots\.txt$ robots-staging.txt [NS,L]
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# REDIRECT WORDPRESS FEEDS TO FEEDBURNER (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
#<IfModule mod_alias.c>
#	RedirectMatch 301 /feed/(atom|rdf|rss|rss2)/?$ http://feedburner.com/yourfeed/
#	RedirectMatch 301 /comments/feed/(atom|rdf|rss|rss2)/?$ http://feedburner.com/yourfeed/
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# HIDE MAINWP CHILD PLUGIN (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteRule ^wp-content/plugins/mainwp-child/(.*)$ /wp-content/plugins/THIS_PLUGIN_DOES_NOT_EXIST [QSA,L]
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# CUSTOM ERROR PAGES (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# See: https://perishablepress.com/custom-http-errors-via-htaccess/
#
#ErrorDocument 400 /errors/400.html
#ErrorDocument 401 /errors/401.html
#ErrorDocument 403 /errors/403.html
#ErrorDocument 404 /errors/404.html
#ErrorDocument 500 /errors/500.html

# ----------------------------------------------------------------------------------------------------------------------
# 301 PAGE REDIRECTS (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# For large-scale WordPress redirects, using the Redirection plugin is recommended:
# Find it at: https://wordpress.org/plugins/redirection/
#
#redirect 301 /old-page-url.html https://www.example.com/new-page-url

# END Jays WordPress .htaccess


# ======================================================================================================================
# 8. WORDPRESS FRONT CONTROLLER (MUST REMAIN AT THE END OF THE FILE)
# ======================================================================================================================
# WordPress core standard rewrite block. Because this rule intercepts all non-static requests and routes them to
# /index.php [L], all custom security rules, SSL enforcement, and optimizations above MUST execute before this block.

# BEGIN WordPress
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteRule ^index\.php$ - [L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule . /index.php [L]
</IfModule>
# END WordPress
