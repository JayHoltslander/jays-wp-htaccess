# BEGIN Jays WordPress .htaccess
# ======================================================================================================================
# JAY'S WORDPRESS .HTACCESS
# Version:      2.5.0
# Released:     2026-09-17
# Repository:   https://github.com/JayHoltslander/jays-wp-htaccess
#
# A production-tested .htaccess template for WordPress websites designed to maximize performance,
# harden security, and provide deep compatibility across Apache 2.2/2.4+, LiteSpeed, and reverse proxies.
#
# TABLE OF CONTENTS:
# ------------------
# 1. EMERGENCY & MAINTENANCE TOGGLES
# 2. DIRECTORY INDEX & SERVER OPTIONS
# 3. MIME TYPES & CHARACTER ENCODINGS
# 4. SECURITY HEADERS & CORS CONTROLS
# 5. PERFORMANCE, COMPRESSION & CACHING
# 6. SECURITY FILTERS & ACCESS RESTRICTIONS
#    6.1 Cloudflare & Reverse Proxy REAL IP Normalization
#    6.2 Advanced Early-Drop Protection (Zero-PHP Overhead Scanner Mitigation)
#    6.3 Block Access to Hidden Files & Directories (ACME / SSL Whitelisted)
#    6.4 File Access Protections (Apache 2.4/2.2 Dual-Compatible: .ht*, wp-config, debug.log, xmlrpc)
#    6.5 Core WordPress Directory Hardening (TRACE, wp-includes)
#    6.6 Hotlinking Defense & Static Asset Performance Short-Circuit
#    6.7 Bot, Enumeration & Spam Query Filtering (Dynamic Requests Only)
#    6.8 IP-Based Access Control Examples
# 7. URL CANONICALIZATION, HTTPS & REDIRECTS
# 8. WORDPRESS FRONT CONTROLLER (Must remain at the very end of the file)
# ======================================================================================================================


# ======================================================================================================================
# 1. EMERGENCY & MAINTENANCE TOGGLES (OPTIONAL)
# ======================================================================================================================

# ----------------------------------------------------------------------------------------------------------------------
# REDIRECT ALL PAGES TO ROOT (EMERGENCY KILL-SWITCH)
# ----------------------------------------------------------------------------------------------------------------------
# Site under attack, database crashed, or undergoing major maintenance?
# Uncommenting this block will temporarily redirect all visitors to the root homepage (/) using a 302 (temporary) redirect.
#
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteCond %{REQUEST_FILENAME} !-f
#	RewriteCond %{REQUEST_FILENAME} !-d
#	RewriteRule .? / [R=302,L]
#</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 301 REDIRECT ALL .SHTML FILES TO .HTML
# ----------------------------------------------------------------------------------------------------------------------
# Useful when migrating legacy server-parsed HTML sites (.shtml) to standard HTML pages without losing SEO rank.
#
#<IfModule mod_rewrite.c>
#	RewriteEngine On
#	RewriteRule ^(.*)\.shtml$ https://www.example.com/$1.html [R=301,L]
#</IfModule>


# ======================================================================================================================
# 2. DIRECTORY INDEX & SERVER OPTIONS
# ======================================================================================================================

# ----------------------------------------------------------------------------------------------------------------------
# FALLBACK FOR INDEX.PHP
# ----------------------------------------------------------------------------------------------------------------------
# Specifies the priority order of default directory index files.
# If index.php is missing (e.g. during a WordPress core update), Apache will seamlessly attempt to serve MAINT-index.html
# from the same directory rather than throwing a generic server error or directory listing.
# Maintenance template example: https://codepen.io/j_holtslander/pen/KNgbMP
DirectoryIndex index.php index.html MAINT-index.html


# ----------------------------------------------------------------------------------------------------------------------
# BLOCK ACCESS TO DIRECTORIES WITHOUT A DEFAULT DOCUMENT (DIRECTORY BROWSING)
# ----------------------------------------------------------------------------------------------------------------------
# Prevents visitors and automated scanners from seeing a file directory index (file tree) if no default index document
# exists in that folder (e.g. /wp-content/uploads/ or /wp-content/plugins/).
# See: https://httpd.apache.org/docs/current/mod/mod_autoindex.html
<IfModule mod_autoindex.c>
	Options -Indexes
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# PREVENT OVERZEALOUS 404 ERRORS FROM APACHE CONTENT NEGOTIATION (MULTIVIEWS)
# ----------------------------------------------------------------------------------------------------------------------
# Apache's MultiViews feature attempts to guess alternative file extensions (e.g. requesting /page matches /page.php).
# This frequently interferes with WordPress URL rewrite rules, causing unexpected 404 errors when a folder or file
# shares the same name as a WordPress page slug.
# See:
# * https://httpd.apache.org/docs/current/content-negotiation.html#multiviews
# * https://www.infomaniak.com/en/support/faq/605/redirect-and-url-rewrite-issues-multiviews-option-in-htaccess
Options -MultiViews

# ----------------------------------------------------------------------------------------------------------------------
# DISABLE SERVER-SIDE INCLUDES (SSI) & CGI SCRIPT EXECUTION
# ----------------------------------------------------------------------------------------------------------------------
# Hardens the environment by disabling legacy Server-Side Includes (.shtml) and direct CGI execution (.cgi, .pl).
Options -ExecCGI -Includes


# ----------------------------------------------------------------------------------------------------------------------
# REMOVE SERVER SIGNATURE FROM ERROR DOCUMENTS
# ----------------------------------------------------------------------------------------------------------------------
# Prevents Apache from appending the server software name, Apache version, OS, and port number to server-generated error pages.
# See:
# * https://httpd.apache.org/docs/current/mod/core.html#serversignature
# * https://techjourney.net/improve-apache-web-server-security-use-servertokens-and-serversignature-to-disable-header/
ServerSignature Off


# ----------------------------------------------------------------------------------------------------------------------
# SHOW THE ADMIN’S EMAIL ADDRESS IN APACHE ERROR MESSAGES (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# If ServerSignature is on or custom error pages are configured, this sets the contact address shown to visitors.
#SetEnv SERVER_ADMIN email@isp.com


# ----------------------------------------------------------------------------------------------------------------------
# INCREASE MAXIMUM PHP UPLOAD & EXECUTION LIMITS (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# Note: These php_value directives only work on servers running Apache with mod_php (prefork).
# On modern PHP-FPM / FastCGI servers (cPanel EA4, Plesk, Nginx/Apache hybrids), placing php_value here will cause a
# 500 Internal Server Error. Configure these in your .user.ini or php.ini instead if using PHP-FPM.
#
#php_value upload_max_filesize 64M
#php_value post_max_size 64M
#php_value max_execution_time 300
#php_value max_input_time 300


# ======================================================================================================================
# 3. MIME TYPES & CHARACTER ENCODINGS
# ======================================================================================================================

# ----------------------------------------------------------------------------------------------------------------------
# DEFAULT CHARACTER SET (UTF-8)
# ----------------------------------------------------------------------------------------------------------------------
# Forces UTF-8 encoding by default for all plain text and HTML responses.
# See: https://httpd.apache.org/docs/current/mod/core.html#adddefaultcharset
AddDefaultCharset utf-8

<IfModule mod_mime.c>
	# Character Encodings for Specific File Extensions
	# See: https://www.w3.org/International/articles/http-charset/
	AddCharset utf-8 .atom \
	                 .bbaw \
	                 .css \
	                 .geojson \
	                 .js \
	                 .json \
	                 .jsonld \
	                 .manifest \
	                 .mjs \
	                 .rdf \
	                 .rss \
	                 .topojson \
	                 .vtt \
	                 .webapp \
	                 .webmanifest \
	                 .xloc \
	                 .xml

	# Data Interchange Formats
	AddType application/atom+xml                        atom
	AddType application/json                            json map topojson
	AddType application/ld+json                         jsonld
	AddType application/rss+xml                         rss
	AddType application/vnd.geo+json                    geojson
	AddType application/xml                             rdf xml

	# JavaScript Modules & Scripts (RFC 9239 Standard: text/javascript)
	# See: https://datatracker.ietf.org/doc/html/rfc9239
	AddType text/javascript                             js mjs

	# Web Application Manifest Files
	# See: https://w3c.github.io/manifest/
	AddType application/manifest+json                   webmanifest
	AddType application/x-web-app-manifest+json         webapp
	AddType text/cache-manifest                         appcache

	# Media Files & Next-Generation Image Formats (AVIF, WebP, JXL)
	# See: https://calendar.perfplanet.com/2020/avif-has-landed/
	AddType audio/mp4                                   f4a f4b m4a
	AddType audio/ogg                                   oga ogg opus
	AddType image/avif                                  avif avifs
	AddType image/bmp                                   bmp
	AddType image/jxl                                   jxl
	AddType image/svg+xml                               svg svgz
	AddType image/webp                                  webp
	AddType image/x-icon                                cur ico
	AddType video/mp4                                   f4v f4p m4v mp4
	AddType video/ogg                                   ogv
	AddType video/webm                                  webm
	AddType video/x-flv                                 flv

	# Web Fonts (RFC 8081 Standard: font/*)
	# See: https://datatracker.ietf.org/doc/html/rfc8081
	AddType font/woff                                   woff
	AddType font/woff2                                  woff2
	AddType font/ttf                                    ttf
	AddType font/otf                                    otf
	AddType font/collection                             ttc
	AddType application/vnd.ms-fontobject               eot

	# Augmented Reality Assets (USDZ for iOS Safari Quick Look)
	# See: https://webkit.org/blog/8421/viewing-augmented-reality-assets-in-safari-for-ios/
	AddType model/vnd.usdz+zip                          usdz

	# Browser Extensions & Miscellaneous
	AddType application/octet-stream                    safariextz
	AddType application/x-bb-appworld                   bbaw
	AddType application/x-chrome-extension              crx
	AddType application/x-opera-extension               oex
	AddType application/x-xpinstall                     xpi
	AddType text/vcard                                  vcard vcf
	AddType text/vnd.rim.location.xloc                  xloc
	AddType text/vtt                                    vtt
	AddType text/x-component                            htc

	# Gzip Encoding for Pre-Compressed SVGZ Images
	# See: https://davidwalsh.name/serve-svg-image
	AddEncoding gzip                                    svgz
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# FORCE SPECIFIC FILES TO DOWNLOAD INSTEAD OF OPENING IN BROWSER (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# By mapping extensions to application/octet-stream, browsers will trigger a "Save File" download dialog.
# See: https://css-tricks.com/snippets/htaccess/force-files-to-download-not-open-in-browser/
#
# AddType application/octet-stream .csv
# AddType application/octet-stream .xls
# AddType application/octet-stream .doc
# AddType application/octet-stream .pdf


# ======================================================================================================================
# 4. SECURITY HEADERS & CORS CONTROLS
# ======================================================================================================================

<IfModule mod_headers.c>
	# ------------------------------------------------------------------------------------------------------------------
	# MIME SNIFFING PROTECTION (X-Content-Type-Options: nosniff)
	# ------------------------------------------------------------------------------------------------------------------
	# Prevents browsers from MIME-sniffing a response away from the declared content-type (e.g. executing user-uploaded
	# images that contain embedded executable JavaScript).
	# Note: "Header always set" guarantees the header is returned on all responses (including 403 blocks and 404s).
	# See: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/X-Content-Type-Options
	Header always set X-Content-Type-Options "nosniff"

	# ------------------------------------------------------------------------------------------------------------------
	# CLICKJACKING PROTECTION (X-Frame-Options: SAMEORIGIN)
	# ------------------------------------------------------------------------------------------------------------------
	# Prevents external malicious websites from embedding your site inside an <iframe>, protecting users from UI redressing
	# and clickjacking attacks.
	# See: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/X-Frame-Options
	Header always append X-Frame-Options SAMEORIGIN

	# ------------------------------------------------------------------------------------------------------------------
	# DISABLE LEGACY XSS AUDITOR (X-XSS-Protection: 0)
	# ------------------------------------------------------------------------------------------------------------------
	# Modern browsers (Chrome, Edge, Firefox, Safari) have removed the legacy reflective XSS auditor.
	# Setting "1; mode=block" has been proven to introduce side-channel data-leak vulnerabilities in older engines.
	# OWASP and MDN recommend setting "0" or relying on Content Security Policy (CSP).
	# See: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/X-XSS-Protection
	Header always set X-XSS-Protection "0"

	# ------------------------------------------------------------------------------------------------------------------
	# REFERRER POLICY (strict-origin-when-cross-origin)
	# ------------------------------------------------------------------------------------------------------------------
	# Sends full URL path on same-origin requests, but only sends the origin (domain) on cross-origin HTTPS requests,
	# and sends no referrer when downgrading from HTTPS to HTTP.
	# See: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Referrer-Policy
	Header always set Referrer-Policy "strict-origin-when-cross-origin"

	# ------------------------------------------------------------------------------------------------------------------
	# PERMISSIONS POLICY (BROWSER HARDWARE & API ACCESS)
	# ------------------------------------------------------------------------------------------------------------------
	# Restricts unauthorized third-party scripts and embedded iframes from accessing device sensors and hardware APIs.
	# See: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Permissions-Policy
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

	# ------------------------------------------------------------------------------------------------------------------
	# CROSS-ORIGIN OPENER POLICY (COOP)
	# ------------------------------------------------------------------------------------------------------------------
	# Isolates the top-level browsing context, preventing cross-origin popups/windows from manipulating the window object.
	# See: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Cross-Origin-Opener-Policy
	Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

	# ------------------------------------------------------------------------------------------------------------------
	# CROSS-ORIGIN RESOURCE POLICY (CORP)
	# ------------------------------------------------------------------------------------------------------------------
	# Protects sensitive documents, REST API responses, and user data from cross-origin leaks and Spectre-style reads.
	# Static assets (fonts, images) are explicitly set to cross-origin in their respective blocks below.
	# See: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Cross-Origin-Resource-Policy
	Header always set Cross-Origin-Resource-Policy "same-origin"

	# ------------------------------------------------------------------------------------------------------------------
	# PROACTIVE BROWSER DNS PREFETCHING (X-DNS-Prefetch-Control: on)
	# ------------------------------------------------------------------------------------------------------------------
	# Instructs modern browsers to proactively pre-resolve DNS lookups for external links, CDNs, and resources,
	# significantly reducing latency when visitors click outbound links or load cross-domain assets.
	# See: https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/X-DNS-Prefetch-Control
	Header always set X-DNS-Prefetch-Control "on"

	# ------------------------------------------------------------------------------------------------------------------
	# REMOVE SERVER SOFTWARE & PINGBACK IDENTIFICATION HEADERS
	# ------------------------------------------------------------------------------------------------------------------
	# Unsets the X-Powered-By header (leaks PHP/server versions) and X-Pingback (advertises XML-RPC pingback features).
	Header unset X-Powered-By
	Header unset X-Pingback
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# ALLOW CROSS-ORIGIN RESOURCE SHARING (CORS) FOR ALL ASSETS (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# See:
# * https://developer.mozilla.org/en-US/docs/Web/HTTP/CORS
# * https://enable-cors.org/
# * https://stackoverflow.com/a/13871027/751570
#
#<IfModule mod_headers.c>
#	Header set Access-Control-Allow-Origin "*"
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# SEND CORS & CORP HEADERS FOR IMAGES
# ----------------------------------------------------------------------------------------------------------------------
# Needed when drawing cross-origin images to HTML5 <canvas> elements without tainting the canvas, and permits CDN sharing.
# See:
# * https://developer.mozilla.org/en-US/docs/Web/HTML/CORS_enabled_image
# * https://blog.chromium.org/2011/07/using-cross-domain-images-in-webgl-and.html
<IfModule mod_setenvif.c>
	<IfModule mod_headers.c>
		<FilesMatch "\.(avifs?|bmp|cur|gif|ico|jpe?g|jxl|png|svgz?|webp)$">
			SetEnvIf Origin ":" IS_CORS
			Header set Access-Control-Allow-Origin "*" env=IS_CORS
			Header set Cross-Origin-Resource-Policy "cross-origin"
		</FilesMatch>
	</IfModule>
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# CROSS-ORIGIN WEB FONTS (CDN FONT SHARING)
# ----------------------------------------------------------------------------------------------------------------------
# Web fonts (WOFF, WOFF2, TTF, EOT) are subject to cross-origin security policies in Firefox, Chrome, and Safari.
# This header ensures fonts load properly when served from a CDN subdomain (e.g. cdn.example.com).
# See: https://davidwalsh.name/cdn-fonts
<IfModule mod_headers.c>
	<FilesMatch "\.(eot|otf|tt[cf]|woff2?)$">
		Header set Access-Control-Allow-Origin "*"
		Header set Cross-Origin-Resource-Policy "cross-origin"
	</FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# UPGRADE INSECURE RESOURCE REQUESTS (CONTENT SECURITY POLICY)
# ----------------------------------------------------------------------------------------------------------------------
# Instructs browsers to automatically upgrade all insecure HTTP asset requests (images, scripts, styles) to HTTPS.
# See: https://github.com/h5bp/server-configs-apache/pull/83/files
<IfModule mod_headers.c>
	Header set Content-Security-Policy "upgrade-insecure-requests" env=HTTPS
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# HTTP STRICT TRANSPORT SECURITY (HSTS - OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# Instructs browsers to ONLY communicate with this domain via HTTPS for the next 1 year (including subdomains).
# (!) CAUTION: Only uncomment after confirming SSL is fully functioning across all subdomains.
# See:
# * https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Strict-Transport-Security
# * https://hstspreload.org/
#
#<IfModule mod_headers.c>
#	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
#</IfModule>


# ======================================================================================================================
# 5. PERFORMANCE, COMPRESSION & CACHING
# ======================================================================================================================

# ----------------------------------------------------------------------------------------------------------------------
# BROTLI COMPRESSION (MOD_BROTLI)
# ----------------------------------------------------------------------------------------------------------------------
# Brotli provides 15–25% higher compression ratios than Gzip on text-based assets (HTML, CSS, JS, SVG, JSON).
# See: https://httpd.apache.org/docs/current/mod/mod_brotli.html
<IfModule mod_brotli.c>
	AddOutputFilterByType BROTLI_COMPRESS \
		application/atom+xml \
		application/javascript \
		application/json \
		application/ld+json \
		application/manifest+json \
		application/rdf+xml \
		application/rss+xml \
		application/schema+json \
		application/vnd.geo+json \
		application/vnd.ms-fontobject \
		application/x-font-ttf \
		application/x-javascript \
		application/x-web-app-manifest+json \
		application/xhtml+xml \
		application/xml \
		font/collection \
		font/eot \
		font/opentype \
		font/otf \
		font/ttf \
		font/woff \
		font/woff2 \
		image/bmp \
		image/svg+xml \
		image/vnd.microsoft.icon \
		image/x-icon \
		text/cache-manifest \
		text/css \
		text/html \
		text/javascript \
		text/plain \
		text/vcard \
		text/vnd.rim.location.xloc \
		text/vtt \
		text/x-component \
		text/x-cross-domain-policy \
		text/xml
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# GZIP COMPRESSION (MOD_DEFLATE)
# ----------------------------------------------------------------------------------------------------------------------
# Standard Gzip compression filter for web servers where mod_brotli is not installed.
# TTF Font compression info: https://divibooster.com/enable-compression-for-the-divi-theme/
# See: https://httpd.apache.org/docs/current/mod/mod_deflate.html
<IfModule mod_deflate.c>
	<IfModule mod_filter.c>
		AddOutputFilterByType DEFLATE \
			application/atom+xml \
			application/javascript \
			application/json \
			application/ld+json \
			application/manifest+json \
			application/rdf+xml \
			application/rss+xml \
			application/schema+json \
			application/vnd.geo+json \
			application/vnd.ms-fontobject \
			application/x-font-ttf \
			application/x-javascript \
			application/x-web-app-manifest+json \
			application/xhtml+xml \
			application/xml \
			font/collection \
			font/eot \
			font/opentype \
			font/otf \
			font/ttf \
			font/woff \
			font/woff2 \
			image/bmp \
			image/svg+xml \
			image/vnd.microsoft.icon \
			image/x-icon \
			text/cache-manifest \
			text/css \
			text/html \
			text/javascript \
			text/plain \
			text/vcard \
			text/vnd.rim.location.xloc \
			text/vtt \
			text/x-component \
			text/x-cross-domain-policy \
			text/xml
	</IfModule>

	# Force compression for mangled Accept-Encoding request headers from aggressive intermediate firewalls/antivirus
	<IfModule mod_setenvif.c>
		<IfModule mod_headers.c>
			SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
			RequestHeader append Accept-Encoding "gzip,deflate" env=HAVE_Accept-Encoding
		</IfModule>

		# Skip compression and prevent redundant Vary headers for already-compressed binary media
		SetEnvIfNoCase Request_URI \.(?:avifs?|avi|bz2|divx|doc|docx|exe|flv|gif|gz|gzip|ico|jpe?g|jxl|m4a|mid|midi|mov|mp3|mp4|mpe?g|ogg|otf|pdf|png|ppt|pptx|ra|ram|rar|svgz|swf|tar|tgz|ttf|wav|webm|webp|wma|wmv|woff2?|xls|xlsx|zip)$ no-gzip dont-vary
	</IfModule>
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# VARY: ACCEPT-ENCODING HEADER
# ----------------------------------------------------------------------------------------------------------------------
# Informs intermediate caches and CDNs (e.g. Cloudflare, Varnish, proxies) that two versions of the asset exist:
# a compressed version and an uncompressed version, preventing cached uncompressed responses from being served to clients.
# See: https://www.maxcdn.com/blog/accept-encoding-its-vary-important/
<IfModule mod_headers.c>
	<FilesMatch "\.(css|gz|html|js|mjs|svg|xml|woff|woff2)$">
		Header append Vary "Accept-Encoding"
	</FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# BROWSER EXPIRES CACHING (MOD_EXPIRES)
# ----------------------------------------------------------------------------------------------------------------------
# Leverages browser caching by setting far-future Expires headers for static assets (CSS, JS, images, web fonts),
# significantly reducing server load, bandwidth consumption, and page load times on repeat visits.
# See: https://httpd.apache.org/docs/current/mod/mod_expires.html
<IfModule mod_expires.c>
	ExpiresActive on
	ExpiresDefault                                      "access plus 1 month"

	# CSS & JavaScript (1 Year - leverages WordPress cache-busting query strings)
	ExpiresByType text/css                              "access plus 1 year"
	ExpiresByType text/javascript                       "access plus 1 year"
	ExpiresByType application/javascript                "access plus 1 year"
	ExpiresByType application/x-javascript              "access plus 1 year"

	# Data Interchange (0 Seconds - ensures dynamic REST API & feeds re-validate)
	ExpiresByType application/atom+xml                  "access plus 1 hour"
	ExpiresByType application/rdf+xml                   "access plus 1 hour"
	ExpiresByType application/rss+xml                   "access plus 1 hour"
	ExpiresByType application/json                      "access plus 0 seconds"
	ExpiresByType application/ld+json                   "access plus 0 seconds"
	ExpiresByType application/schema+json               "access plus 0 seconds"
	ExpiresByType application/vnd.geo+json              "access plus 0 seconds"
	ExpiresByType application/xml                       "access plus 0 seconds"
	ExpiresByType text/xml                              "access plus 0 seconds"

	# Favicons and Cursors (1 Week)
	ExpiresByType image/vnd.microsoft.icon              "access plus 1 week"
	ExpiresByType image/x-icon                          "access plus 1 week"

	# HTML & App Manifests (0 Seconds - never cache dynamic HTML pages indefinitely)
	ExpiresByType text/html                             "access plus 0 seconds"
	ExpiresByType application/manifest+json             "access plus 1 week"
	ExpiresByType application/x-web-app-manifest+json   "access plus 0 seconds"
	ExpiresByType text/cache-manifest                   "access plus 0 seconds"

	# Media Files & Images (6 Months)
	ExpiresByType audio/ogg                             "access plus 6 months"
	ExpiresByType image/avif                            "access plus 6 months"
	ExpiresByType image/bmp                             "access plus 6 months"
	ExpiresByType image/gif                             "access plus 6 months"
	ExpiresByType image/jpeg                            "access plus 6 months"
	ExpiresByType image/jpg                             "access plus 6 months"
	ExpiresByType image/jxl                             "access plus 6 months"
	ExpiresByType image/png                             "access plus 6 months"
	ExpiresByType image/svg+xml                         "access plus 6 months"
	ExpiresByType image/webp                            "access plus 6 months"
	ExpiresByType video/mp4                             "access plus 6 months"
	ExpiresByType video/ogg                             "access plus 6 months"
	ExpiresByType video/webm                            "access plus 6 months"

	# Web Fonts (6 Months)
	ExpiresByType application/vnd.ms-fontobject         "access plus 6 months"
	ExpiresByType font/eot                              "access plus 6 months"
	ExpiresByType font/opentype                         "access plus 6 months"
	ExpiresByType font/otf                              "access plus 6 months"
	ExpiresByType application/x-font-ttf                "access plus 6 months"
	ExpiresByType font/ttf                              "access plus 6 months"
	ExpiresByType application/font-woff                 "access plus 6 months"
	ExpiresByType application/x-font-woff               "access plus 6 months"
	ExpiresByType font/woff                             "access plus 6 months"
	ExpiresByType application/font-woff2                "access plus 6 months"
	ExpiresByType font/woff2                            "access plus 6 months"

	# Cross-Domain Policy
	ExpiresByType text/x-cross-domain-policy            "access plus 1 week"
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# CACHE-CONTROL HEADERS (OPTIONAL ALTERNATIVE)
# ----------------------------------------------------------------------------------------------------------------------
# Fine-grained Cache-Control directives. Can be adjusted if mod_expires is unavailable.
#
#<IfModule mod_headers.c>
#	<FilesMatch "\.(avi|doc|flv|gif|ico|jpe?g|mp3|mp4|mov|pdf|png|ppt|swf|wav|wmv)$">
#		Header set Cache-Control "max-age=2592000, public"
#	</FilesMatch>
#	<FilesMatch "\.(css|js|mjs)$">
#		Header set Cache-Control "max-age=31536000, public"
#	</FilesMatch>
#	<FilesMatch "\.(x?html?|php)$">
#		Header set Cache-Control "max-age=0, private, must-revalidate"
#	</FilesMatch>
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# IMMUTABLE CACHE-CONTROL FOR VERSIONED STATIC ASSETS (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# Tells browsers that the asset content will NEVER change during its lifetime, preventing browsers from making
# conditional 304 re-validation requests on reload.
# See: https://www.keycdn.com/blog/cache-control-immutable
#
#<IfModule mod_headers.c>
#	<FilesMatch "\.(avi|css|doc|flv|gif|ico|jpe?g|js|mjs|mov|mp3|mp4|pdf|png|ppt|swf|wav|wmv|woff2?)$">
#		Header set Cache-Control "public, max-age=31536000, immutable"
#	</FilesMatch>
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# ENABLE TCP KEEP-ALIVE (HTTP/1.x ONLY)
# ----------------------------------------------------------------------------------------------------------------------
# Allows multiple HTTP requests to be sent over the same TCP connection on HTTP/1.x.
# Scoped with !mod_http2.c because HTTP/2 and HTTP/3 prohibit the Connection header (RFC 7540 §8.1.2.2).
<IfModule mod_headers.c>
	<IfModule !mod_http2.c>
		Header set Connection keep-alive
	</IfModule>
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# MEDIA BYTE-RANGE STREAMING (ACCEPT-RANGES)
# ----------------------------------------------------------------------------------------------------------------------
# Informs mobile and modern browsers (iOS Safari, Chrome) that media files support byte-range requests,
# allowing smooth scrubbing and seeking in audio and video players without buffering from byte 0.
<IfModule mod_headers.c>
	<FilesMatch "\.(m4[av]|mp[34]|mpe?g|ogg|opus|wav|webm)$">
		Header set Accept-Ranges bytes
	</FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# DISABLE ETAGS & PRAGMA
# ----------------------------------------------------------------------------------------------------------------------
# Disabling ETags avoids redundant inode-based revalidation across multi-server / clustered hosting environments.
# See: https://crunchify.com/how-to-speed-up-wordpress-leveraging-browser-caching-via-htaccess/
<IfModule mod_headers.c>
	Header unset Pragma
	Header unset ETag
</IfModule>
FileETag None

# ----------------------------------------------------------------------------------------------------------------------
# SERVE WEBP IMAGES INSTEAD OF JPG/PNG IF SUPPORTED (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# If the visitor's browser sends an Accept: image/webp header and an image.jpg.webp file exists, serve WebP dynamically.
# Source: https://github.com/vincentorback/WebP-images-with-htaccess
