#</IfModule>
#<IfModule mod_headers.c>
#	Header append Vary Accept env=REQUEST_image
#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# WEBP SUBSTITUTION FOR "EWWW IMAGE OPTIMIZER" WORDPRESS PLUGIN (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# See: https://wordpress.org/plugins/ewww-image-optimizer/
#
#<IfModule mod_rewrite.c>
