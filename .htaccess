#</IfModule>

# ----------------------------------------------------------------------------------------------------------------------
# GOOGLE MOD_PAGESPEED MODULE (OPTIONAL)
# ----------------------------------------------------------------------------------------------------------------------
# Only uncomment if mod_pagespeed is compiled and installed on the Apache server.
#
#<IfModule pagespeed_module>
#	ModPagespeed on
#	ModPagespeedEnableFilters extend_cache,combine_css,combine_javascript,collapse_whitespace,move_css_to_head
#</IfModule>


# ======================================================================================================================
# 6. SECURITY FILTERS & ACCESS RESTRICTIONS
# ======================================================================================================================

# ----------------------------------------------------------------------------------------------------------------------
# 6.1 CLOUDFLARE & REVERSE PROXY REAL IP NORMALIZATION
# ----------------------------------------------------------------------------------------------------------------------
# When a site sits behind Cloudflare or a reverse proxy, %{REMOTE_ADDR} reflects the proxy's IP rather than the visitor.
# This rule dynamically detects Cloudflare's CF-Connecting-IP header and normalizes the client IP into %{ENV:REAL_IP}.
# If no proxy header is detected, it automatically falls back to %{REMOTE_ADDR}.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# 1. Default REAL_IP to direct TCP remote address
	RewriteRule .* - [E=REAL_IP:%{REMOTE_ADDR}]

	# 2. If request arrives via Cloudflare, dynamically override REAL_IP
	RewriteCond %{HTTP:CF-Connecting-IP} .
	RewriteRule .* - [E=REAL_IP:%{HTTP:CF-Connecting-IP}]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.2 ADVANCED EARLY-DROP PROTECTION: BLOCK SCANNERS & EXPLOIT PROBES
# ----------------------------------------------------------------------------------------------------------------------
# Drops known automated vulnerability scans, shell probes, and exploit payloads immediately at the Apache web server layer
# with 403 Forbidden [F,L] before PHP or the WordPress database initializes, saving CPU and database connections.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# 0. Restrict HTTP Methods: Block Unusual / Potentially Dangerous Request Methods (Permits standard REST methods)
	RewriteCond %{REQUEST_METHOD} !^(GET|POST|HEAD|PUT|DELETE|OPTIONS)$ [NC]
	RewriteRule .* - [F,L]

	# 1. Block Probes for Non-WordPress Executable & Legacy Framework Extensions
	RewriteRule \.(jsp|asp|aspx|action|do|cgi|cfm|pl|dll|exe|nsf)$ - [F,L,NC]

	# 2. Block Environment, Config, and Cloud Metadata Probes (Catches .env*, .git*, .aws*, .kube*, etc.)
	RewriteRule (^|/)(\.env.*|\.git.*|\.svn.*|\.dockercfg.*|\.aws.*|\.kube.*|\.npmrc.*|\.DS_Store|\.editorconfig|\.ssh.*|\.bash_history|web\.config.*)$ - [F,L,NC]

	# 3. Block Developer Manifests & Lockfiles (composer.json, package.json, webpack.config.js)
	RewriteRule ^(package\.json|package-lock\.json|composer\.json|composer\.lock|yarn\.lock|tsconfig\.json|webpack\.config\.js)$ - [F,L,NC]

	# 4. Block Database Dumps, Backups, and Migration/Installer Scripts
	# Note: If your site legitimately serves downloadable .zip / .tar / .gz archives, remove those extensions from the list below.
	RewriteRule \.(sql|sqlite|db|dump|bak|backup|old|orig|swp|tar|gz|tgz|zip|rar)$ - [F,L,NC]
	RewriteRule (installer.*\.php|dup-installer|import-backup.*\.php) - [F,L,NC]

	# 5. Block Known Web Shells & Vulnerability Scanner Script Names (c99, r57, alfa, wso, b374k, adminer)
	RewriteRule (eval-stdin\.php|alfa.*\.php|wso.*\.php|c99.*\.php|r57.*\.php|b374k.*\.php|shell\.php|cmd\.php|adminer.*\.php|phpmyadmin.*\.php) - [F,L,NC]

	# 6. Block Enterprise Appliances, VPNs, Remote Desktop, and Actuator Probes (actuator, swagger-ui, solr, RDWeb)
	RewriteRule ^(dana-na|remote/|logon/LogonPoint|RDWeb|vpn/|wsman|autodiscover|solr|console/|crowd/|CTCWebService|actuator|swagger-ui|api-docs|v2/api-docs) - [F,L,NC]

	# 7. Block Malicious Query String Injections & Directory Traversal Exploits (eval, base64, <script, ../)
	RewriteCond %{QUERY_STRING} (base64_encode|base64_decode|eval\(|<script|GLOBALS\[|_REQUEST\[|\.\./|\.\.%2f|fgt_lang) [NC]
	RewriteRule .* - [F,L]

	# 8. Block Direct PHP Execution in Uploads, Languages & Upgrade Dirs (Malware Staging Defense)
	RewriteRule ^wp-content/(uploads|languages|upgrade)/.*(?i)\.(php[0-9]?|pht|phtml?|phps|phar|pl|py|cgi)$ - [F,L]

	# 9. Block Direct PHP Execution Inside Themes Directory (Template files should only be executed by WordPress core)
	RewriteRule ^wp-content/themes/.*(?i)\.(php[0-9]?|pht|phtml?|phps|phar)$ - [F,L]

	# 9b. Block Direct PHP Execution Inside Plugins Directory (OPTIONAL)
	# (!) CAUTION: Many plugins (e.g. WooCommerce payment webhooks, PayPal IPN, captcha generators) require direct PHP
	# execution. Only uncomment if you have thoroughly tested your site's checkout flows and AJAX integrations.
	# RewriteRule ^wp-content/plugins/.*(?i)\.(php[0-9]?|pht|phtml?|phps|phar)$ - [F,L]

	# 10. Block WordPress REST API User Enumeration Scans (/wp-json/wp/v2/users)
	RewriteCond %{REQUEST_URI} ^/wp-json/wp/v2/users [NC]
	RewriteCond %{QUERY_STRING} !context=edit [NC]
	RewriteRule .* - [F,L]

	# 11. Block Known Vulnerability Scanners & Exploit Tool User-Agents (wpscan, sqlmap, nikto, masscan, etc.)
	RewriteCond %{HTTP_USER_AGENT} (acunetix|dirbuster|gobuster|havij|masscan|nessus|nikto|nmap|openvas|shodan|sqlmap|wpscan|zgrab) [NC]
	RewriteRule .* - [F,L]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.3 BLOCK ACCESS TO HIDDEN FILES & DIRECTORIES
# ----------------------------------------------------------------------------------------------------------------------
# Blocks access to dotfiles and hidden folders (e.g. .git, .env) while explicitly preserving access to
# /.well-known/acme-challenge/ so automated Let's Encrypt / Certbot SSL certificate renewals function properly.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_URI} !^/\.well-known/
	RewriteCond %{SCRIPT_FILENAME} -d [OR]
	RewriteCond %{SCRIPT_FILENAME} -f
	RewriteRule "(^|/)\." - [F]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.4 FILE ACCESS PROTECTIONS (APACHE 2.4 & 2.2 DUAL-COMPATIBLE)
# ----------------------------------------------------------------------------------------------------------------------
# Uses dual <IfModule mod_authz_core.c> (Apache 2.4 'Require all denied') and fallback (!mod_authz_core.c 'Deny from all')
# to prevent HTTP 500 errors across both legacy and modern hosting environments.

# Protect this .htaccess file and other .ht* files (.htpasswd)
<FilesMatch "^.*\.([Hh][Tt][Aa]|[Hh][Tt][Pp][Aa][Ss][Ss][Ww][Dd])">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
		Satisfy All
	</IfModule>
</FilesMatch>

# Protect Sensitive File Extensions (Source code, logs, configs, database backups, editor swaps)
<FilesMatch "(^#.*#|\.(bak|conf|config|dist|fla|in[ci]|ini|log|old|orig|original|psd|sh|sql|sw[op])|~)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
		Satisfy All
	</IfModule>
</FilesMatch>

# Disable Direct Access to PHP Configuration Files (.user.ini, php.ini)
<FilesMatch "^(\.user\.ini|php\.ini)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Disable Direct Access to WordPress Configuration and Sample Files
<FilesMatch "^(wp-config\.php|wp-config-sample\.php)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Disable Direct Access to WordPress Debug Log
<Files "debug.log">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</Files>

# Disable Direct Access to SFTP Deployment Configuration
<Files "sftp-config.json">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</Files>

# Prevent WordPress Version Exposure via Readme / License Files
<FilesMatch "^(readme|license|licence)\.(html|txt)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# Disable XML-RPC (Prevents Brute-Force & Amplification DDoS Attacks)
# See:
# * https://blog.sucuri.net/2015/10/brute-force-amplification-attacks-against-wordpress-xmlrpc.html
# * https://www.digitalocean.com/community/tutorials/how-to-protect-wordpress-from-xml-rpc-attacks-on-ubuntu-14-04#method-3-manually-blocking-all-xml-rpc-traffic
<Files "xmlrpc.php">
	<IfModule mod_authz_core.c>
		# To allow Jetpack or the WordPress Mobile App, uncomment the lines below:
		# Require ip 192.0.64.0/18
		# Require ip 122.248.245.244/32
		# Require ip 54.217.201.243/32
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
		# Allow from 192.0.64.0/18
	</IfModule>
</Files>


# ----------------------------------------------------------------------------------------------------------------------
# 6.5 CORE WORDPRESS DIRECTORY HARDENING
# ----------------------------------------------------------------------------------------------------------------------

# Disable HTTP TRACE and TRACK Methods (Prevents Cross-Site Tracing / XST Attacks)
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
	RewriteRule .* - [F]
</IfModule>

# Block Direct Access to WordPress Installer (wp-admin/install.php)
# Once WordPress is installed, install.php is never legitimately needed.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^wp-admin/install\.php$ - [F,L,NC]
</IfModule>

# Restrict Direct Access to WP-Includes PHP Files
# See: https://wordpress.org/documentation/article/hardening-wordpress/#securing-wp-includes
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteRule ^wp-admin/includes/ - [F,L]
	RewriteRule !^wp-includes/ - [S=3]
	RewriteRule ^wp-includes/[^/]+\.php$ - [F,L]
	RewriteRule ^wp-includes/js/tinymce/langs/.+\.php - [F,L]
	RewriteRule ^wp-includes/theme-compat/ - [F,L]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.6 HOTLINKING DEFENSE & STATIC ASSET PERFORMANCE SHORT-CIRCUIT
# ----------------------------------------------------------------------------------------------------------------------

# Block Specific Scraper Sites from Stealing Bandwidth by Hotlinking to Images
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?discussionist\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?sodahead\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?pixshark\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?advanceindiana\.blogspot\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?galleryhip\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?freespeechwisconsin\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?memekid\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?3edgesword\.blogspot\.ca(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?neogaf\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?locationrebel\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?pixgood\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?pudelekf23\.blogspot\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?fstdt\.com(/.*)*$ [NC,OR]
	RewriteCond %{HTTP_REFERER} ^http://(www\.)?zerohedge\.com(/.*)*$ [NC]
	RewriteRule \.(gif|jpe?g|mng|png|webp|avif)$ - [NC,F]
</IfModule>

# PERFORMANCE: SHORT-CIRCUIT EXISTING STATIC ASSETS (BYPASS DEEP REWRITE SCANS)
# If an actual static file exists on disk, stop rewrite evaluation immediately with [L].
# This ensures static requests (CSS, JS, fonts, images) do not waste CPU cycles evaluating dynamic query string rules.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_FILENAME} -f
	RewriteCond %{REQUEST_URI} \.(avifs?|bmp|css|cur|eot|gif|ico|jpe?g|js|json|mjs|mp4|ogg|otf|png|svgz?|ttf|webp|woff2?)$ [NC]
	RewriteRule ^ - [L]
</IfModule>


# ----------------------------------------------------------------------------------------------------------------------
# 6.7 BOT, ENUMERATION & SPAM QUERY FILTERING (RUNS ON DYNAMIC REQUESTS ONLY)
# ----------------------------------------------------------------------------------------------------------------------

# Stop WordPress Username Enumeration Scans (?author=1)
# Scoped to front-end requests to preserve legitimate admin author filtering inside /wp-admin/edit.php
# See: https://www.wpbeginner.com/wp-tutorials/how-to-discourage-brute-force-by-blocking-author-scans-in-wordpress/
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteCond %{REQUEST_URI} !^/wp-admin
	RewriteCond %{QUERY_STRING} (author=\d+) [NC]
	RewriteRule .* - [F,L]
</IfModule>

# Block Advanced SQL Injection (SQLi) & Remote File Inclusion (RFI) Query Payloads
# Drops common database extraction patterns (UNION SELECT, BENCHMARK, SLEEP, null bytes, /etc/passwd traversal).
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{QUERY_STRING} (concat|union.*select|information_schema|benchmark|sleep\([0-9]+\)|load_file|cast\(|md5\(|benchmark\() [NC,OR]
	RewriteCond %{QUERY_STRING} (%00|%2500|\0) [NC,OR]
	RewriteCond %{QUERY_STRING} (=(\/|\\)\.\.(\/|\\)|\.ini|\/etc\/(passwd|shadow|hosts)) [NC]
	RewriteRule .* - [F,L]
</IfModule>

# Block Automated No-Referrer Comment Spam Bots (wp-comments-post.php)
# Legitimate user comments always arrive with a valid HTTP referrer matching the site's domain.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_METHOD} POST
	RewriteCond %{REQUEST_URI} ^/wp-comments-post\.php$ [NC]
	RewriteCond %{HTTP_REFERER} !^https?://(www\.)?%{HTTP_HOST} [NC,OR]
	RewriteCond %{HTTP_USER_AGENT} ^$
	RewriteRule .* - [F,L]
</IfModule>

# Block Common Malicious Bot Queries & Scanner Payloads (TimThumb, FCKeditor, RevSlider exploits)
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{QUERY_STRING} http\:\/\/www\.google\.com\/humans\.txt\? [NC,OR]
	RewriteCond %{QUERY_STRING} (img|thumb|thumb_editor|thumbopen)\.php [NC,OR]
	RewriteCond %{QUERY_STRING} fckeditor [NC,OR]
	RewriteCond %{QUERY_STRING} revslider [NC]
	RewriteRule .* - [F,L]
</IfModule>

# Abuse HTTP Referrer Blocking (Blocks Scraper & Referrer Spam Networks)
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTP_REFERER} 100dollars-seo\.com [NC,OR]
	RewriteCond %{HTTP_REFERER} best-seo-offer\.com [NC,OR]
	RewriteCond %{HTTP_REFERER} buttons-for-your-website\.com [NC,OR]
	RewriteCond %{HTTP_REFERER} free-social-buttons\.com [NC,OR]
	RewriteCond %{HTTP_REFERER} semalt\.com [NC,OR]
	RewriteCond %{HTTP_REFERER} todaperfeita\.com [NC,OR]
	RewriteCond %{HTTP_REFERER} www[0-9]?\.free-social-buttons\.com [NC]
	RewriteRule .* - [F,L]
</IfModule>

# Block Known Drupal/CMS Spam Bot Registration Probes
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{QUERY_STRING} q=(user/register|node/add) [NC]
	RewriteRule .* - [F,L]
</IfModule>


